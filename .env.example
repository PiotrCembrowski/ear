# Copy to .env.local and fill in values from your Supabase project:
# Supabase Dashboard → Project Settings → API (or "API Keys").
# Never commit real values.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy "anon" key.
# Safe to expose to the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this app (used in auth emails). Use your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret key (sb_secret_...) or the legacy "service_role" key.
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: history-write rate limit per user (defaults: 120 writes per 600 s).
# HISTORY_RATE_LIMIT_MAX=120
# HISTORY_RATE_LIMIT_WINDOW_SECONDS=600

# Optional, tests only: a throwaway local Postgres database for migration/RLS tests.
# The test suite DROPS AND RECREATES this database. Never point it at Supabase.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/soundmatch_test
